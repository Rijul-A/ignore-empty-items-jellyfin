#!/bin/bash

# Pre-commit hook to enforce code style and 72 character line limit

FILES=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.(cs|js)$')

if [ -z "$FILES" ]; then
    exit 0
fi

FAILED=0

# 1. Check for line length (72 characters)
for FILE in $FILES; do
    # Skip generated files
    if [[ $FILE == *"obj/"* ]] || [[ $FILE == *"bin/"* ]]; then
        continue
    fi

    LONG_LINES=$(awk 'length > 72 {print FNR}' "$FILE")

    if [ -n "$LONG_LINES" ]; then
        echo "Error: $FILE has lines exceeding 72 characters at lines:"
        echo "$LONG_LINES" | xargs echo
        FAILED=1
    fi
done

# 2. Run dotnet format verification for C# files
CS_FILES=$(echo "$FILES" | grep '\.cs$')
if [ -n "$CS_FILES" ]; then
    echo "Running dotnet format verification..."
    if ! dotnet format ./Jellyfin.Plugin.IgnoreEmptyFolders --verify-no-changes; then
        echo "Error: Code style violations found. Run 'dotnet format' to fix them."
        FAILED=1
    fi
fi

if [ $FAILED -eq 1 ]; then
    exit 1
fi

exit 0
